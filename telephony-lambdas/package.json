{
  "name": "telephony-lambdas",
  "version": "1.0.0",
  "description": "Telephony API Lambda functions",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "package": "npm run build && npm run package:lambdas",
    "package:lambdas": "cd dist && zip -r ../voice-handler.zip voice-handler && zip -r ../gather-handler.zip gather-handler && zip -r ../status-handler.zip status-handler"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "axios": "^1.6.0",
    "ioredis": "^5.3.2",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}